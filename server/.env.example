# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored. Never commit real keys or passwords.

# Server
PORT=4000
# The website's address (CORS). Local: Vite dev server. Render: your static site URL.
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string.
# Local example below. Neon/Render: paste the provider's string and use ?sslmode=verify-full
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/chat_portfolio
# true for Neon or any hosted database, false for a local Postgres without SSL
DB_SSL=false

# AI provider: Gemini through its OpenAI-compatible endpoint
# Get a key at https://aistudio.google.com/apikey
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
